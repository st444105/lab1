<Window x:Class="lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников"
        Width="1100"
        Height="700">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,10">

            <Button Content="Загрузить иконки"
                    Click="LoadIconsButton_Click"
                    Margin="5"
                    Padding="10,5"/>

            <Button Content="Сохранить JSON"
                    Click="SaveJsonButton_Click"
                    Margin="5"
                    Padding="10,5"/>

            <Button Content="Загрузить JSON"
                    Click="LoadJsonButton_Click"
                    Margin="5"
                    Padding="10,5"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <GroupBox Header="Противники"
                      Grid.Column="0"
                      Margin="5">

                <Grid Margin="5">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="EnemyListBox"
                             SelectionChanged="EnemyListBox_SelectionChanged"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Content="Добавить"
                                Click="AddEnemyButton_Click"
                                Margin="5"
                                Padding="10,5"/>

                        <Button Content="Изменить"
                                Click="EditEnemyButton_Click"
                                Margin="5"
                                Padding="10,5"/>

                        <Button Content="Удалить"
                                Click="DeleteEnemyButton_Click"
                                Margin="5"
                                Padding="10,5"/>

                    </StackPanel>

                </Grid>

            </GroupBox>

            <GroupBox Header="Иконки"
                      Grid.Column="1"
                      Margin="5">

                <ListBox x:Name="IconsListBox"
                         SelectionChanged="IconsListBox_SelectionChanged">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                </ListBox>

            </GroupBox>

            <GroupBox Header="Данные противника"
                      Grid.Column="2"
                      Margin="5">

                <ScrollViewer>

                    <StackPanel Margin="15">

                        <TextBlock Text="Имя:"
                                   Margin="5"/>

                        <TextBox x:Name="NameTextBox"
                                 Margin="5"/>


                        <TextBlock Text="Иконка:"
                                   Margin="5"/>

                        <TextBox x:Name="IconNameTextBox"
                                 Margin="5"
                                 IsReadOnly="True"/>


                        <Image x:Name="MainEnemyIcon"
                               Height="150"
                               Width="150"
                               Margin="10"
                               Stretch="Uniform"/>


                        <TextBlock Text="Base Life:"
                                   Margin="5"/>

                        <TextBox x:Name="BaseLifeTextBox"
                                 Text="100"
                                 Margin="5"/>


                        <TextBlock Text="Life Modifier:"
                                   Margin="5"/>

                        <TextBox x:Name="LifeModifierTextBox"
                                 Text="1"
                                 Margin="5"/>


                        <TextBlock Text="Base Gold:"
                                   Margin="5"/>

                        <TextBox x:Name="BaseGoldTextBox"
                                 Text="10"
                                 Margin="5"/>


                        <TextBlock Text="Gold Modifier:"
                                   Margin="5"/>

                        <TextBox x:Name="GoldModifierTextBox"
                                 Text="1"
                                 Margin="5"/>


                        <TextBlock Text="Spawn Chance:"
                                   Margin="5"/>

                        <TextBox x:Name="SpawnChanceTextBox"
                                 Text="1"
                                 Margin="5"/>

                    </StackPanel>

                </ScrollViewer>

            </GroupBox>

        </Grid>

    </Grid>

</Window>